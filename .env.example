# Address used by the Go HTTP server. Docker Compose overrides this to :8080.
CASTDOCK_LISTEN_ADDR=127.0.0.1:8080

# SQLite file. The parent directory must exist and be writable.
CASTDOCK_DATABASE_PATH=./data/castdock.db

# Automatic feed refresh cadence. Set to 0 to disable scheduled refreshes.
CASTDOCK_REFRESH_INTERVAL=1h
CASTDOCK_REFRESH_CONCURRENCY=4

# Outbound feed request timeout and maximum accepted response size.
CASTDOCK_HTTP_TIMEOUT=20s
CASTDOCK_MAX_FEED_BYTES=33554432

# Maximum accepted OPML upload size.
CASTDOCK_MAX_OPML_BYTES=5242880
CASTDOCK_MAX_OPML_FEEDS=500

# Disabled by default to prevent feed URLs from reaching local/private services.
CASTDOCK_ALLOW_PRIVATE_FEEDS=false

# debug, info, warn, or error.
CASTDOCK_LOG_LEVEL=info

# Emit one info-level access log for every HTTP request.
CASTDOCK_ACCESS_LOG_ENABLED=false
